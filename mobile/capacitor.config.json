{
  "appId": "com.thesparkle.mobile",
  "appName": "TheSparkle",
  "webDir": "www",
  "backgroundColor": "#071b4d",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#071b4d",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#071b4d",
      "style": "LIGHT"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
